{
  "name": "us-west-2027-trip",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:check": "node scripts/build-app.mjs --check",
    "check": "node scripts/build-app.mjs --check && node scripts/check-project.mjs",
    "test": "node scripts/build-app.mjs --check && node --test tests/*.test.mjs && node scripts/check-project.mjs",
    "test:browser": "node scripts/check-browsers.mjs",
    "test:sql": "node --test scripts/check-trip-sql.mjs",
    "test:ci": "node scripts/check-ci.mjs",
    "test:browser:repeat": "node scripts/check-boundaries.mjs --after-full",
    "test:browser:smoke": "node scripts/check-browser-engines.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.112.4",
    "pg": "8.16.3",
    "playwright": "1.62.1"
  },
  "packageManager": "npm@11.19.1"
}
